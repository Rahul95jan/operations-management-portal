# Backend environment variables example (DO NOT commit real secrets)
# PostgreSQL connection string (Neon)
DATABASE_URL=postgresql://user:password@db.neon.tech:5432/dbname

# Portal URL used for crafting absolute links in emails
PORTAL_URL=https://your-vercel-frontend.vercel.app

# JWT secret - set a strong random string in production
JWT_SECRET_KEY=change-me-to-a-secure-random-value

# Allowed CORS origins (comma-separated). If unset, localhost dev origins are allowed.
ALLOWED_ORIGINS=http://localhost:3000,https://your-vercel-frontend.vercel.app

# Email SMTP settings (if used)
# EMAIL_ADDRESS=you@example.com
# EMAIL_PASSWORD=supersecret
# SMTP_SERVER=smtp.example.com
# SMTP_PORT=587
